<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:wfp="http://wfp.com/schema/tracker"
             targetNamespace="http://wfp.com/samples">
  <process id="timerEventSubprocess" isExecutable="true">
    <startEvent id="start"/>
    <userTask id="open" name="Open" wfp:statusCategory="OPEN"/>
    <userTask id="done" name="Done" wfp:statusCategory="DONE"/>
    <endEvent id="closed"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="open"/>
    <sequenceFlow id="f2" name="Finish" sourceRef="open" targetRef="done"/>
    <sequenceFlow id="f3" name="Close" sourceRef="done" targetRef="closed"/>
    <subProcess id="nightly" name="Nightly check" triggeredByEvent="true">
      <startEvent id="nightlyStart"><timerEventDefinition><timeCycle>R/P1D</timeCycle></timerEventDefinition></startEvent>
      <userTask id="check" name="Check"/>
      <endEvent id="nightlyEnd"/>
      <sequenceFlow id="c1" sourceRef="nightlyStart" targetRef="check"/>
      <sequenceFlow id="c2" sourceRef="check" targetRef="nightlyEnd"/>
    </subProcess>
  </process>
</definitions>

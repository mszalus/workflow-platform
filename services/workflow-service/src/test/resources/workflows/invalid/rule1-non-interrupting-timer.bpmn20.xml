<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:wfp="http://wfp.com/schema/tracker"
             targetNamespace="http://wfp.com/samples">
  <process id="nonInterruptingTimer" isExecutable="true">
    <startEvent id="start"/>
    <userTask id="open" name="Open" wfp:statusCategory="OPEN"/>
    <boundaryEvent id="reminder" attachedToRef="open" cancelActivity="false">
      <timerEventDefinition><timeDuration>P1D</timeDuration></timerEventDefinition>
    </boundaryEvent>
    <userTask id="escalated" name="Escalated" wfp:statusCategory="TODO"/>
    <userTask id="done" name="Done" wfp:statusCategory="DONE"/>
    <endEvent id="closed"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="open"/>
    <sequenceFlow id="f2" name="Finish" sourceRef="open" targetRef="done"/>
    <sequenceFlow id="f3" sourceRef="reminder" targetRef="escalated"/>
    <sequenceFlow id="f4" name="Finish" sourceRef="escalated" targetRef="done"/>
    <sequenceFlow id="f5" name="Close" sourceRef="done" targetRef="closed"/>
  </process>
</definitions>

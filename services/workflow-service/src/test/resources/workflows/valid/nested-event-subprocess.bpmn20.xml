<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:wfp="http://wfp.com/schema/tracker"
             targetNamespace="http://wfp.com/samples">
  <message id="cancelMessage" name="cancel"/>
  <process id="nestedEventSubprocess" isExecutable="true">
    <startEvent id="start"/>
    <userTask id="draft" name="Draft" wfp:statusCategory="OPEN"/>
    <subProcess id="inApproval" name="In Approval" wfp:statusCategory="IN_PROGRESS">
      <startEvent id="approvalStart"/>
      <userTask id="legal" name="Legal approval"/>
      <endEvent id="approvalEnd"/>
      <sequenceFlow id="a1" sourceRef="approvalStart" targetRef="legal"/>
      <sequenceFlow id="a2" sourceRef="legal" targetRef="approvalEnd"/>
      <subProcess id="withdraw" name="Withdraw" triggeredByEvent="true">
        <startEvent id="withdrawStart"><messageEventDefinition messageRef="cancelMessage"/></startEvent>
        <endEvent id="withdrawn"/>
        <sequenceFlow id="w1" sourceRef="withdrawStart" targetRef="withdrawn"/>
      </subProcess>
    </subProcess>
    <userTask id="approved" name="Approved" wfp:statusCategory="DONE"/>
    <endEvent id="closed"/>
    <sequenceFlow id="f1" sourceRef="start" targetRef="draft"/>
    <sequenceFlow id="f2" name="Submit" sourceRef="draft" targetRef="inApproval"/>
    <sequenceFlow id="f3" name="Complete" sourceRef="inApproval" targetRef="approved"/>
    <sequenceFlow id="f4" name="Close" sourceRef="approved" targetRef="closed"/>
  </process>
</definitions>

<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
             xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
             xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
             xmlns:wfp="http://wfp.com/schema/tracker"
             targetNamespace="http://wfp.com/samples">
  <process id="trackerFlow" name="Tracker flow" isExecutable="true">
    <startEvent id="start"/>
    <userTask id="open" name="Open" wfp:statusCategory="OPEN"/>
    <userTask id="doing" name="Doing" wfp:statusCategory="IN_PROGRESS"/>
    <userTask id="done" name="Done" wfp:statusCategory="DONE"/>
    <exclusiveGateway id="doneChoice"/>
    <endEvent id="closed" name="Closed"/>
    <sequenceFlow id="toOpen" sourceRef="start" targetRef="open"/>
    <sequenceFlow id="startWork" name="Start work" sourceRef="open" targetRef="doing"/>
    <sequenceFlow id="finish" name="Finish" sourceRef="doing" targetRef="done"/>
    <sequenceFlow id="doneLeaves" sourceRef="done" targetRef="doneChoice"/>
    <sequenceFlow id="reopen" name="Reopen" sourceRef="doneChoice" targetRef="open"/>
    <sequenceFlow id="close" name="Close" sourceRef="doneChoice" targetRef="closed"/>
  </process>
  <bpmndi:BPMNDiagram id="diagram">
    <bpmndi:BPMNPlane id="plane" bpmnElement="trackerFlow">
      <bpmndi:BPMNShape id="start_di" bpmnElement="start"><dc:Bounds x="40" y="62" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="open_di" bpmnElement="open"><dc:Bounds x="130" y="40" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doing_di" bpmnElement="doing"><dc:Bounds x="290" y="40" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="done_di" bpmnElement="done"><dc:Bounds x="450" y="40" width="100" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="doneChoice_di" bpmnElement="doneChoice"><dc:Bounds x="610" y="55" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="closed_di" bpmnElement="closed"><dc:Bounds x="720" y="62" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="toOpen_di" bpmnElement="toOpen"><di:waypoint x="76" y="80"/><di:waypoint x="130" y="80"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="startWork_di" bpmnElement="startWork"><di:waypoint x="230" y="80"/><di:waypoint x="290" y="80"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="finish_di" bpmnElement="finish"><di:waypoint x="390" y="80"/><di:waypoint x="450" y="80"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="doneLeaves_di" bpmnElement="doneLeaves"><di:waypoint x="550" y="80"/><di:waypoint x="610" y="80"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="reopen_di" bpmnElement="reopen"><di:waypoint x="635" y="105"/><di:waypoint x="635" y="170"/><di:waypoint x="180" y="170"/><di:waypoint x="180" y="120"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="close_di" bpmnElement="close"><di:waypoint x="660" y="80"/><di:waypoint x="720" y="80"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</definitions>

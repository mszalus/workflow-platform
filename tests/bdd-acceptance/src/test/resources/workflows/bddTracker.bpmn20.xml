<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:wfp="http://wfp.com/schema/tracker"
             targetNamespace="http://wfp.com/bdd">
  <process id="bddTracker" name="BDD tracker" isExecutable="true">
    <startEvent id="start"/>
    <userTask id="open" name="Open" wfp:statusCategory="OPEN"/>
    <exclusiveGateway id="openChoice"/>
    <userTask id="doing" name="Doing" wfp:statusCategory="IN_PROGRESS"/>
    <userTask id="done" name="Done" wfp:statusCategory="DONE"/>
    <endEvent id="closed" name="Closed"/>
    <endEvent id="rejected" name="Rejected"/>
    <sequenceFlow id="toOpen" sourceRef="start" targetRef="open"/>
    <sequenceFlow id="openLeaves" sourceRef="open" targetRef="openChoice"/>
    <sequenceFlow id="accept" name="Accept" sourceRef="openChoice" targetRef="doing"/>
    <sequenceFlow id="reject" name="Reject" sourceRef="openChoice" targetRef="rejected"/>
    <sequenceFlow id="finish" name="Finish" sourceRef="doing" targetRef="done"/>
    <sequenceFlow id="close" name="Close" sourceRef="done" targetRef="closed"/>
  </process>
</definitions>

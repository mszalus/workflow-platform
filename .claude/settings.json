  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit-tests.sh\"",
            "timeout": 600,
            "statusMessage": "Running unit tests before commit..."
          },
          {
            "type": "command",
            "if": "Bash(git push*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-push-tests.sh\"",
            "timeout": 1800,
            "statusMessage": "Running full suite + Playwright before push..."
          }
        ]
      }
    ]
  }
}